# 本地连接凭据和主机信任记录不进入版本控制。
.env
.env.*
!.env.example
.ssh_known_hosts

# 本地运行环境、编辑器配置和缓存不进入版本控制。
.venv/
.idea/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 临时工作目录不作为项目交付内容。
/tmp/

# 私钥文件不进入版本控制。
*.pem
*.key
id_rsa
id_ed25519

# 原始网格、数组、归档及编译产物单独迁移，不进入新增Git提交。
*.obj
*.vtp
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.gz
*.so
*.dll
*.lib
*.pdb
*.pack

# Word临时锁文件不作为文档交付。
~$*

# 裸Git镜像由迁移资产保存，不把内部对象和引用当作项目源码。
/实验结果/Geogram原生源码只读镜像/
